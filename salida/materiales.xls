   <Row ss:StyleID="N"><Cell><Data ss:Type="String">Hierro 12mm</Data></Cell><Cell><Data ss:Type="String">barra</Data></Cell><Cell><Data ss:Type="Number">80</Data></Cell><Cell><Data ss:Type="Number">2800</Data></Cell><Cell><Data ss:Type="Number">224000</Data></Cell></Row>
