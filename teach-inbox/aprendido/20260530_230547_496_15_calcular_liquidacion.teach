# pregunta: calcular liquidacion de sueldo
agente plan "LiquidaciÃ³n de sueldo" como plan
agente paso plan hacer "Calcular haberes y deducciones"
guardar sueldo_bruto = 500000
guardar jubilacion = 0.11
guardar obra_social = 0.03
guardar aporte_sindical = 0.02
multiplicar $sueldo_bruto $jubilacion como desc_jubilacion
multiplicar $sueldo_bruto $obra_social como desc_obra
