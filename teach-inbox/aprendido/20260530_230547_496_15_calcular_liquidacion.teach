sumar $desc_jubilacion $desc_obra como total_parcial
sumar $total_parcial $desc_sindical como total_deducciones
restar $sueldo_bruto $total_deducciones como sueldo_neto
ia decir "=== LIQUIDACIÃ“N DE SUELDO ==="
ia decir "Sueldo bruto:"
decir $sueldo_bruto
