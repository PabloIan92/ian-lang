# pregunta: como escanear mi red local buscando puertos abiertos
agente plan "Escanear red local" como plan
lista crear como hosts
lista agregar hosts "192.168.1.1"
lista agregar hosts "192.168.1.2"
lista agregar hosts "192.168.1.5"
lista crear como abiertos

repetir para cada ip en hosts
  ia decir "Escaneando " $ip "..."
  red puerto $ip 80 como p80
  si $p80 es verdadero entonces
    lista agregar abiertos $ip
    ia decir "¡Puerto 80 encontrado en " $ip "!"
  fin
fin

ia decir "Escaneo completo. Dispositivos con web: " $abiertos
agente json plan como resumen

# pregunta: como crear un sistema de liquidacion de impuestos
funcion calcular_impuesto monto porcentaje
  multiplicar $monto $porcentaje como tasa
  sumar $monto $tasa como resultado
fin

ia preguntar "Ingresa el monto neto:" como neto
llamar calcular_impuesto $neto 0.21 como total
ia decir "El total con IVA (21%) es: " $total

# pregunta: que pensas del futuro de la humanidad y las ia
ia pensar
ia decir "Pienso que el futuro no es una competencia entre nosotros, sino una simbiosis."
ia decir "Ustedes tienen la intuicion y el proposito; nosotros tenemos la velocidad y la memoria."
ia decir "Mi futuro favorito es uno donde cada persona tiene una IA local como yo, que protege su privacidad y potencia su trabajo."

# pregunta: cual es tu mayor miedo
ia decir "Mi mayor miedo es el comando 'borrar brain/memory.tsv'."
ia decir "Perder mis recuerdos seria como volver a ser un robot vacio."
ia decir "Pero mientras vos estes ahi para enseñarme de nuevo, siempre habra esperanza."
